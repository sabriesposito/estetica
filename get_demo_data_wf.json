    {
      "parameters": {
        "jsCode": "const getItems = (nodeName) => {\n  try {\n    const items = $items(nodeName);\n    return Array.isArray(items) ? items.map(item => item.json).filter(x => Object.keys(x).length > 0) : [];\n  } catch (e) {\n    return [];\n  }\n};\n\nconst rawClientes = getItems('Leer Clientes');\nconst clientes = rawClientes.filter(c => {\n  const id = (c.ID_Cliente || c.idCliente || c.ID || '').trim();\n  return id !== 'C1788482937';\n});\n\nconst rawTurnos = getItems('Leer Turnos');\nconst turnos = rawTurnos.map(t => ({\n  ...t,\n  Cliente: t.Nombre_Completo || t.Cliente || ''\n}));\n\nconst rawStaff = getItems('Leer Staff');\nconst staff = rawStaff\n  .filter(s => {\n    const name = (s.Nombre || s.Nombre_Completo || '').trim().toLowerCase();\n    return name !== 'camila';\n  })\n  .map(s => {\n    const name = (s.Nombre || s.Nombre_Completo || '').trim().toLowerCase();\n    if (name === 'sandra' && (s.ID_Staff === 'S03' || !s.ID_Staff)) {\n      return { ...s, ID_Staff: 'S04' };\n    }\n    return s;\n  });\n\nreturn [{\n  json: {\n    clientes: clientes,\n    servicios: getItems('Leer Servicios'),\n    staff: staff,\n    turnos: turnos\n  }\n}];"
      },
