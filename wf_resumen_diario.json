    {
      "parameters": {
        "sendTo": "={{ $json.ownerEmail }}",
        "subject": "=📊 Resumen Diario ({{ $json.fechaHoy }}) — {{ $json.brandName }}: {{ $json.facturacionFmt }}",
        "message": "=<!DOCTYPE html>\n<html>\n<head><meta charset=\"utf-8\"></head>\n<body style=\"font-family: 'Segoe UI', Arial, sans-serif; background-color: #faf7f2; margin: 0; padding: 20px; color: #44403c;\">\n  <div style=\"max-width: 580px; margin: 0 auto; background: #ffffff; border-radius: 18px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #f1f0ee;\">\n    \n    <!-- ENCABEZADO -->\n    <div style=\"background: linear-gradient(135deg, #0ea5e9, #0284c7); padding: 28px 24px; text-align: center; color: #ffffff;\">\n      <span style=\"font-size: 32px; display: block; margin-bottom: 6px;\">✨📊</span>\n      <h1 style=\"margin: 0 0 4px 0; font-size: 22px; font-weight: 800; letter-spacing: -0.3px; color: #ffffff;\">{{ $json.brandName }}</h1>\n      <p style=\"margin: 0; font-size: 14px; opacity: 0.95; font-weight: 600;\">Cierre y Resumen Diario de Operaciones</p>\n      <div style=\"display: inline-block; background-color: rgba(255,255,255,0.22); padding: 4px 14px; border-radius: 20px; font-size: 12px; margin-top: 10px; font-weight: 700;\">\n        📅 Fecha: {{ $json.fechaHoy }}\n      </div>\n    </div>\n\n    <!-- CUERPO PRINCIPAL -->\n    <div style=\"padding: 24px 24px 28px 24px;\">\n      \n      <!-- TARJETAS DE MÉTRICAS DESTACADAS -->\n      <div style=\"display: flex; gap: 12px; margin-bottom: 20px;\">\n        <div style=\"flex: 1; background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 14px; padding: 16px; text-align: center;\">\n          <div style=\"font-size: 11px; font-weight: 700; color: #065f46; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;\">Facturación Estimada</div>\n          <div style=\"font-size: 24px; font-weight: 900; color: #047857;\">{{ $json.facturacionFmt }}</div>\n        </div>\n        <div style=\"flex: 1; background-color: #f0f9ff; border: 1px solid #bae6fd; border-radius: 14px; padding: 16px; text-align: center;\">\n          <div style=\"font-size: 11px; font-weight: 700; color: #0369a1; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;\">Turnos del Día</div>\n          <div style=\"font-size: 24px; font-weight: 900; color: #0284c7;\">{{ $json.totalTurnos }}</div>\n        </div>\n      </div>\n\n      <!-- DESGLOSE DE ESTADOS -->\n      <div style=\"background-color: #fafaf9; border: 1px solid #e7e5e4; border-radius: 14px; padding: 16px 20px; margin-bottom: 22px;\">\n        <div style=\"font-size: 13px; font-weight: 800; color: #1c1917; margin-bottom: 12px; display: flex; align-items: center; gap: 6px;\">\n          <span>📌</span> Balance de Asistencia\n        </div>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size: 13.5px;\">\n          <tr>\n            <td style=\"padding: 6px 0; color: #78716c;\">✅ Confirmados / Atendidos:</td>\n            <td style=\"padding: 6px 0; color: #047857; font-weight: 700; text-align: right;\">{{ $json.confirmados }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 6px 0; color: #78716c;\">⏳ Agendados / Pendientes:</td>\n            <td style=\"padding: 6px 0; color: #0284c7; font-weight: 700; text-align: right;\">{{ $json.agendados }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 6px 0; color: #78716c; border-bottom: 1px dashed #e7e5e4;\">❌ Cancelaciones:</td>\n            <td style=\"padding: 6px 0; color: #e11d48; font-weight: 700; text-align: right; border-bottom: 1px dashed #e7e5e4;\">{{ $json.cancelados }}</td>\n          </tr>\n          <tr>\n            <td style=\"padding: 8px 0 2px 0; color: #44403c; font-weight: 700;\">⭐ Servicio Más Solicitado:</td>\n            <td style=\"padding: 8px 0 2px 0; color: #0369a1; font-weight: 800; text-align: right;\">{{ $json.topServicio }}</td>\n          </tr>\n        </table>\n      </div>\n\n      <!-- DESGLOSE POR PROFESIONAL -->\n      <div style=\"background-color: #ffffff; border: 1px solid #e7e5e4; border-radius: 14px; padding: 16px 20px; margin-bottom: 22px;\">\n        <div style=\"font-size: 13px; font-weight: 800; color: #1c1917; margin-bottom: 12px;\">\n          👤 Rendimiento por Profesional\n        </div>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"font-size: 13px;\">\n          <thead>\n            <tr style=\"border-bottom: 1px solid #f1f0ee; color: #a8a29e; font-size: 11px; text-transform: uppercase;\">\n              <th align=\"left\" style=\"padding-bottom: 8px;\">Profesional</th>\n              <th align=\"center\" style=\"padding-bottom: 8px;\">Turnos</th>\n              <th align=\"right\" style=\"padding-bottom: 8px;\">Subtotal</th>\n            </tr>\n          </thead>\n          <tbody>\n            {{ Object.entries($json.staffBreakdown).map(([stName, stData]) => `\n              <tr>\n                <td style=\"padding: 7px 0; font-weight: 600; color: #292524; border-bottom: 1px dashed #f5f5f4;\">${stName}</td>\n                <td align=\"center\" style=\"padding: 7px 0; color: #78716c; border-bottom: 1px dashed #f5f5f4;\">${stData.turnos}</td>\n                <td align=\"right\" style=\"padding: 7px 0; font-weight: 700; color: #047857; border-bottom: 1px dashed #f5f5f4;\">$${stData.total.toLocaleString('de-DE')}</td>\n              </tr>\n            `).join('') || '<tr><td colspan=\"3\" style=\"padding: 10px 0; color: #a8a29e; text-align: center;\">Sin turnos activos hoy</td></tr>' }}\n          </tbody>\n        </table>\n      </div>\n\n      <!-- BOTÓN DIRECTO AL PANEL ADMIN -->\n      <a href=\"https://estetica.neco-dev.cloud\" style=\"display: block; width: 100%; text-align: center; background-color: #0284c7; color: #ffffff !important; font-weight: 800; text-decoration: none; padding: 14px 0; border-radius: 12px; font-size: 14.5px; box-sizing: border-box; box-shadow: 0 4px 12px rgba(2,132,199,0.25);\">\n        🖥️ Abrir Panel de Control\n      </a>\n    </div>\n\n    <!-- FOOTER -->\n    <div style=\"background-color: #faf7f2; padding: 16px 20px; text-align: center; font-size: 11.5px; color: #a8a29e; border-top: 1px solid #f1f0ee; line-height: 1.4;\">\n      Reporte automatizado emitido por <strong>{{ $json.brandName }}</strong>.<br>\n      Para cambiar el mail de recepción, edítalo en la sección de Marca del panel de administración.\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
