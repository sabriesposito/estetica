      "parameters": {
        "jsCode": "\nconst brandingData = $('Obtener Branding').first().json || {};\nconst turnosItems = $('Obtener Turnos').all();\nconst serviciosItems = $('Obtener Servicios').all();\nconst staffItems = $('Obtener Staff').all();\n\n// Fecha local de hoy (Argentina UTC-3)\nconst ahora = new Date();\nconst fechaHoy = new Date(ahora.getTime() - 3 * 3600 * 1000).toISOString().split('T')[0];\n\n// Mapeos de nombres y precios\nconst preciosMap = {};\nserviciosItems.forEach(s => {\n  const item = s.json;\n  const rawCost = item.Costo !== undefined ? item.Costo : 0;\n  const num = parseInt(rawCost.toString().replace(/[^0-9]/g, ''), 10) || 0;\n  if (item.ID_Servicio) preciosMap[item.ID_Servicio.toString().trim().toLowerCase()] = num;\n  if (item.Nombre_Servicio) preciosMap[item.Nombre_Servicio.toString().trim().toLowerCase()] = num;\n});\n\nconst staffMap = {};\nstaffItems.forEach(st => {\n  const item = st.json;\n  if (item.ID_Staff) staffMap[item.ID_Staff.toString().trim()] = item.Nombre;\n});\n\n// Filtrar turnos del día\nconst turnosHoy = turnosItems.filter(t => {\n  const f = (t.json.Fecha || t.json.fecha || '').toString().trim();\n  return f === fechaHoy;\n});\n\nlet totalTurnos = turnosHoy.length;\nlet facturacionTotal = 0;\nlet confirmados = 0;\nlet agendados = 0;\nlet cancelados = 0;\n\nconst staffBreakdown = {};\nconst serviciosCount = {};\n\nturnosHoy.forEach(t => {\n  const estado = (t.json.Estado || t.json.estado || 'Agendado').toString().trim();\n  const rawSvc = (t.json.ID_Servicio || t.json.Servicio || '').toString().trim();\n  const rawStaffId = (t.json.ID_Staff || '').toString().trim();\n  const staffName = staffMap[rawStaffId] || t.json.Staff || rawStaffId || 'Sin asignar';\n\n  const costo = preciosMap[rawSvc.toLowerCase()] || 0;\n\n  if (estado.toLowerCase() === 'cancelado') {\n    cancelados++;\n  } else {\n    facturacionTotal += costo;\n    if (estado.toLowerCase().includes('confirmado')) {\n      confirmados++;\n    } else {\n      agendados++;\n    }\n\n    // Por profesional\n    if (!staffBreakdown[staffName]) staffBreakdown[staffName] = { turnos: 0, total: 0 };\n    staffBreakdown[staffName].turnos++;\n    staffBreakdown[staffName].total += costo;\n\n    // Por servicio\n    serviciosCount[rawSvc] = (serviciosCount[rawSvc] || 0) + 1;\n  }\n});\n\n// Servicio más solicitado\nlet topServicio = \"Ninguno\";\nlet maxSvcCount = 0;\nfor (const [sName, sCount] of Object.entries(serviciosCount)) {\n  if (sCount > maxSvcCount) {\n    maxSvcCount = sCount;\n    topServicio = sName + ' (' + sCount + ')';\n  }\n}\n\n// Destinatario del correo\nconst ownerEmail = (brandingData.ownerEmail && brandingData.ownerEmail.trim().length > 3)\n  ? brandingData.ownerEmail.trim()\n  : 'espositosabrina29@gmail.com';\n\nconst brandName = brandingData.name || 'Lumina Estética';\nconst facturacionFmt = '$' + facturacionTotal.toLocaleString('de-DE');\n\nreturn [{\n  json: {\n    fechaHoy,\n    totalTurnos,\n    facturacionTotal,\n    facturacionFmt,\n    confirmados,\n    agendados,\n    cancelados,\n    turnosEfectivos: confirmados + agendados,\n    topServicio,\n    staffBreakdown,\n    ownerEmail,\n    brandName,\n    brandingData,\n    turnosDetalle: turnosHoy.map(t => ({\n      hora: t.json.Hora_Inicio || '',\n      cliente: t.json.Nombre_Completo || t.json.Cliente || 'Cliente',\n      servicio: t.json.ID_Servicio || '',\n      staff: staffMap[t.json.ID_Staff] || t.json.ID_Staff || '',\n      estado: t.json.Estado || 'Agendado',\n      monto: '$' + ((preciosMap[(t.json.ID_Servicio || '').toLowerCase()] || 0).toLocaleString('de-DE'))\n    }))\n  }\n}];\n"
      },
      "name": "Calcular Métricas del Día",
      "type": "n8n-nodes-base.code",
